{
  "name": "simple-dashboard-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app/api src/server/auth eslint-rules",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:contract": "node scripts/run-contract-tests.mjs",
    "script:check-env": "node scripts/check-env.mjs",
    "script:check-i18n": "node scripts/check-i18n.mjs",
    "e2e:install": "playwright install",
    "test:e2e": "playwright test",
    "audit:routes": "node scripts/audit-route-inventory.mjs",
    "audit:env": "node scripts/audit-env-inventory.mjs",
    "audit:events": "node scripts/audit-event-inventory.mjs",
    "audit:dashboard-usage": "node scripts/audit-dashboard-usage.mjs",
    "audit:baseline": "npm run audit:routes && npm run audit:env && npm run audit:events",
    "check:final": "node scripts/check-final-acceptance.mjs",
    "db:backup": "node scripts/db-backup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1030.0",
    "@aws-sdk/client-glue": "^3.1030.0",
    "@mariozechner/pi-agent-core": "0.70.6",
    "@mariozechner/pi-ai": "0.70.6",
    "@mariozechner/pi-coding-agent": "0.70.6",
    "@types/pg": "^8.18.0",
    "antd": "^5.22.0",
    "echarts": "^5.5.0",
    "next": "^15.0.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typebox": "1.1.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^10.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4"
  }
}
